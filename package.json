    "@clerk/ui": "^1.40.1",
    "@heroicons/react": "^2.2.0",
    "@sidekickicons/react": "^0.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.53.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
